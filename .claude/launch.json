{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "haoku",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "webapp",
        "--",
        "--strictPort",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "haoku-cf",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "webapp",
        "wrangler",
        "dev",
        "--config",
        "webapp/wrangler.jsonc",
        "--port",
        "8787"
      ],
      "port": 8787
    }
  ]
}
